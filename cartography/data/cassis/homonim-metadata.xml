            <gmd:title xsi:type="gmd:PT_FreeText_PropertyType">
              <gco:CharacterString>MNT Bathymétrique de façade du Golfe du Lion - Côte d'Azur (Projet Homonim)</gco:CharacterString>
              <gmd:PT_FreeText>
                <gmd:textGroup>
