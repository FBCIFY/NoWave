NOWAVE_DB_PASSWORD=change-me-before-use
NOWAVE_DB_PORT=55432
NOWAVE_WEB_PORT=8080
NOWAVE_WEB_HTTPS_PORT=8443
NOWAVE_API_PORT=8000
DATABASE_URL=postgresql://nowave:change-me-before-use@localhost:55432/nowave
# Firebase pour les tests locaux avec Docker Compose :
GOOGLE_CLOUD_PROJECT=blueway-dev
FIREBASE_SERVICE_ACCOUNT_FILE=./path-to-local-firebase-adminsdk.json
FIREBASE_WEB_API_KEY=change-me-before-use
# Jeton Mapbox public pk.* autorisé pour localhost et 127.0.0.1 :
MAPBOX_PUBLIC_TOKEN=

# Stockage des photos :
PHOTO_STORAGE_BUCKET=your-private-scaleway-bucket
PHOTO_STORAGE_REGION=fr-par
SCW_ACCESS_KEY=configure-outside-git
SCW_SECRET_KEY=configure-outside-git
